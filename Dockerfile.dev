# Dockerfile.dev — entorno de desarrollo/entrenamiento MULTIPLATAFORMA.
# Reproducible en cualquier Linux/macOS con Docker (host-independiente).
# Build:  docker build -f Dockerfile.dev -t dt-newver-dev .
# Tests:  docker run --rm -v "$PWD":/work dt-newver-dev
FROM python:3.12-slim

WORKDIR /work

# libgl1/libglib2.0-0: requeridos por opencv (cv2) en headless Linux.
RUN apt-get update && apt-get install -y --no-install-recommends \
        git libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-dev.txt .
RUN pip install --no-cache-dir -r requirements-dev.txt

COPY . .

# Por defecto valida todo el stack.
CMD ["python", "-m", "pytest", "-q"]
