# Dockerfile.dev — entorno de desarrollo/entrenamiento MULTIPLATAFORMA.
# Reproducible en cualquier Linux/macOS con Docker (host-independiente).
# Usa uv (Astral) como gestor de paquetes: instalaciones rapidas y deterministas.
# Sin apt: opencv-python-headless no requiere libs de sistema -> construye en
# cualquier entorno (incluso con repos de SO restringidos).
# Build:  docker build -f Dockerfile.dev -t dt-newver-dev .
# Tests:  docker run --rm -v "$PWD":/work dt-newver-dev
FROM python:3.12-slim-bookworm

WORKDIR /work

# uv: gestor de paquetes moderno (estado del arte), ~10-100x mas rapido que pip.
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

COPY requirements-dev.txt .
RUN uv pip install --system --no-cache -r requirements-dev.txt

COPY . .

# Por defecto valida todo el stack.
CMD ["python", "-m", "pytest", "-q"]
